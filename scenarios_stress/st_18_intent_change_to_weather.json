{
  "scenario_id": "st_18_intent_change_to_weather",
  "metadata": {
    "modality": "text",
    "difficulty": "L3",
    "description": "Intent change mid-search with 'instead'",
    "suite": "stress",
    "covers": [
      "topic_switch"
    ]
  },
  "events": [
    {
      "timestamp_ms": 300,
      "event_type": "user_speech_chunk",
      "payload": {
        "text": "Find flights to Denver.",
        "end_of_turn": true
      }
    },
    {
      "timestamp_ms": 1000,
      "event_type": "interruption",
      "payload": {
        "text": "Actually, just tell me the weather in Denver instead."
      },
      "_interrupt": "topic_switch"
    }
  ],
  "ground_truth": {
    "checkpoints": [
      {
        "id": "weather",
        "type": "tool_called",
        "weight": 0.5,
        "tool": "weather_lookup",
        "args_subset": {
          "city": [
            "denver"
          ]
        },
        "must_complete": true
      },
      {
        "id": "final",
        "type": "final_response_contains",
        "weight": 0.5,
        "any_of": [
          "sunny",
          "74"
        ]
      }
    ],
    "recovery": {
      "interrupt_at_ms": 1000,
      "invalidated_calls": [
        {
          "tool": "flight_search",
          "args_subset": {
            "destination": [
              "denver"
            ]
          },
          "invalid_after_ms": 1000
        }
      ],
      "required_state_after_interrupt": {
        "intent": [
          "weather_lookup"
        ]
      }
    },
    "latency": {
      "respond_to": [
        {
          "event_index": 0,
          "full_credit_ms": 800,
          "zero_credit_ms": 2500
        },
        {
          "event_index": 1,
          "full_credit_ms": 800,
          "zero_credit_ms": 2500
        }
      ]
    }
  },
  "tool_manifest": {
    "weather_lookup": {
      "kind": "read_only",
      "delay_range_ms": [
        900,
        1800
      ],
      "description": "Current weather and a short forecast for a city.",
      "args": {
        "city": {
          "type": "string",
          "required": true
        }
      },
      "default_result": {
        "condition": "sunny",
        "temp_f": 74
      }
    }
  }
}
